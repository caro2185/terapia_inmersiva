/* ============================================
   ROOT
   ============================================ */
#dashboard-root {
    width: 100%;
    height: 100%;
    background-color: rgb(18, 18, 22);
    padding: 20px;
    flex-direction: column;
}

/* ============================================
   HEADER
   ============================================ */
#header {
    margin-bottom: 20px;
    flex-direction: column;
}

.label-subtitulo {
    font-size: 11px;
    color: rgb(120, 120, 130);
    letter-spacing: 1px;
    margin-bottom: 5px;
}

.titulo-principal {
    font-size: 32px;
    color: rgb(120, 200, 80);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.label-descripcion {
    font-size: 13px;
    color: rgb(150, 150, 160);
}

/* ============================================
   SELECTOR DE TERAPIAS
   ============================================ */
#selector-terapias {
    flex-direction: row;
    margin-bottom: 15px;
}

#selector-terapias Button {
    padding: 10px 20px;
    margin-right: 10px;
    background-color: rgb(35, 35, 42);
    color: rgb(200, 200, 200);
    border-width: 0;
    border-radius: 8px;
    font-size: 14px;
    transition-duration: 0.3s;
}

#selector-terapias Button:hover {
    background-color: rgb(55, 55, 65);
}

#selector-terapias Button.activo {
    background-color: rgb(80, 160, 50);
    color: white;
    -unity-font-style: bold;
}

/* ============================================
   FILTROS DE FECHA
   ============================================ */
#filtros-fecha {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    padding: 15px;
    background-color: rgb(28, 28, 34);
    border-radius: 8px;
}

#filtros-fecha Label {
    color: rgb(150, 150, 160);
    font-size: 12px;
    margin-right: 8px;
}

#filtros-fecha TextField {
    width: 120px;
    margin-right: 15px;
}

#filtros-fecha Button {
    padding: 8px 15px;
    margin-right: 10px;
    background-color: rgb(40, 40, 50);
    color: rgb(200, 200, 200);
    border-width: 0;
    border-radius: 6px;
    font-size: 12px;
}

#filtros-fecha Button.activo {
    background-color: rgb(80, 160, 50);
    color: white;
}

/* ============================================
   TARJETAS DE RESUMEN
   ============================================ */
#tarjetas-resumen {
    flex-direction: row;
    margin-bottom: 20px;
}

#tarjeta-sesiones,
#tarjeta-dias,
#tarjeta-eficacia {
    flex-grow: 1;
    padding: 20px;
    background-color: rgb(28, 28, 34);
    border-radius: 10px;
    margin-right: 15px;
    flex-direction: column;
}

#tarjeta-eficacia {
    margin-right: 0;
}

.label-titulo-tarjeta {
    font-size: 11px;
    color: rgb(120, 120, 130);
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.valor-grande {
    font-size: 36px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.label-pie-tarjeta {
    font-size: 12px;
    color: rgb(120, 120, 130);
}

/* ============================================
   SECCIÓN DE GRÁFICA
   ============================================ */
#seccion-grafica {
    background-color: rgb(28, 28, 34);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
    flex-direction: column;
}

.titulo-seccion {
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.label-subtitulo-seccion {
    font-size: 12px;
    color: rgb(120, 120, 130);
    margin-bottom: 15px;
}

#grafica-container {
    flex-direction: row;
    height: 280px;
    margin-bottom: 10px;
}

#eje-y {
    width: 50px;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 5px;
    padding-bottom: 5px;
}

#eje-y Label {
    font-size: 11px;
    color: rgb(150, 150, 160);
    -unity-text-align: middle-right;
    width: 100%;
}

#area-grafica {
    flex-grow: 1;
    border-left-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(60, 60, 70);
}

#puntos-container {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-around;
    align-items: flex-end;
    padding: 5px 10px;
    height: 100%;
}

.punto-grafico {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    align-self: flex-end;
    border-width: 2px;
    border-color: rgb(28, 28, 34);
    transition-duration: 0.3s;
}

.punto-grafico:hover {
    width: 18px;
    height: 18px;
}

.punto-verde { background-color: rgb(80, 200, 100); }
.punto-amarillo { background-color: rgb(230, 200, 50); }
.punto-rojo { background-color: rgb(220, 80, 80); }

#etiquetas-x {
    flex-direction: row;
    justify-content: space-around;
    margin-left: 50px;
    margin-top: 5px;
}

#etiquetas-x Label {
    font-size: 10px;
    color: rgb(150, 150, 160);
    -unity-text-align: middle-center;
}

#leyenda-grafica {
    flex-direction: row;
    justify-content: center;
    margin-top: 15px;
    padding-top: 15px;
    border-top-width: 1px;
    border-color: rgb(50, 50, 60);
}

#leyenda-grafica Label {
    font-size: 12px;
    color: rgb(180, 180, 190);
    margin-right: 25px;
}

/* ============================================
   SECCIÓN DE TABLA
   ============================================ */
#seccion-tabla {
    background-color: rgb(28, 28, 34);
    border-radius: 10px;
    padding: 20px;
    flex-direction: column;
    flex-grow: 1;
}

#cabecera-tabla {
    margin-bottom: 15px;
    flex-direction: column;
}

.label-titulo-tabla {
    font-size: 18px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.label-info-tabla {
    font-size: 12px;
    color: rgb(120, 120, 130);
}

#encabezados-tabla {
    flex-direction: row;
    padding: 10px 15px;
    background-color: rgb(40, 40, 48);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

#encabezados-tabla Label {
    flex-grow: 1;
    font-size: 11px;
    color: rgb(150, 150, 160);
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

#cuerpo-tabla {
    flex-grow: 1;
    max-height: 300px;
}

.fila-tabla {
    flex-direction: row;
    padding: 10px 15px;
    border-bottom-width: 1px;
    border-color: rgb(40, 40, 48);
}

.fila-tabla:hover {
    background-color: rgb(40, 40, 48);
}

.fila-tabla > Label {
    flex-grow: 1;
    font-size: 13px;
    color: rgb(220, 220, 220);
}

.fila-promedio {
    background-color: rgb(45, 45, 55);
    -unity-font-style: bold;
}

.celda-puntaje-verde { color: rgb(80, 200, 100); }
.celda-puntaje-amarillo { color: rgb(230, 200, 50); }
.celda-puntaje-rojo { color: rgb(220, 80, 80); }