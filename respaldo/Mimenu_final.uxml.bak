<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/styles.uss?fileID=7433441132597879392&amp;guid=63858aba5f259cf429fb46386a74fd93&amp;type=3#styles"/>
    <ui:VisualElement name="Contenedor" class="contenedor" style="flex-grow: 1;">
        <ui:VisualElement name="izquierda" class="izq" style="flex-grow: 1; background-color: rgb(24, 23, 23);">
            <ui:VisualElement name="logo" class="logo" style="flex-grow: 1;"/>
            <ui:VisualElement name="botones" class="botones" style="flex-grow: 1;">
                <ui:Button text="Inicio de sesión" name="jugar" class="botones-menu" style="height: 56px; transition-duration: 0.5s;"/>
                <ui:Button text="Terapias" name="terapias" class="botones-menu" style="display: none;"/>
                <ui:Button text="Manual" name="jugar" class="botones-menu"/>
            </ui:VisualElement>
            <ui:VisualElement name="footer" class="footer" style="flex-grow: 1;">
                <ui:VisualElement name="footer-logo" class="footer-logo" style="flex-grow: 1;"/>
                <ui:Label text="Version 1.0  Rehabilitación Motriz / Cognitiva  (Build: 2026)" name="footer-texto" class="footer-texto"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="derecha" class="derecha" style="flex-grow: 1; translate: 0% 0; position: relative; flex-shrink: 0;">
            <ui:VisualElement name="terapias" class="terapias" style="align-items: center; flex-direction: column; align-self: flex-start; justify-content: flex-start; align-content: flex-start; display: none;">
                <ui:Label text="Terapias  de rehabilitación para miembro superior" name="terapias-titulo" class="terapias-titulo" style="align-items: center;"/>
                <ui:VisualElement name="terapy" class="terapy" style="flex-grow: 1;">
                    <ui:VisualElement name="terapy-izq" class="terapyizq" style="flex-grow: 1;">
                        <ui:Button text="" name="terapy1" class="terapy123" style="background-image: url(&quot;project://database/Assets/imagenes/terapy-globos.png?fileID=21300000&amp;guid=26315993cd9c24d449d786d2aae8239f&amp;type=3#terapy-globos&quot;); background-position-x: center; background-position-y: center; -unity-background-scale-mode: scale-and-crop; background-color: rgb(193, 185, 185);"/>
                        <ui:Button text="" name="terapy2" class="terapy123"/>
                        <ui:Button text="" name="terapy3" class="terapy123"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button text="VOLVER" name="volver" parse-escape-sequences="true" class="volver"/>
            </ui:VisualElement>
            <ui:VisualElement name="login" class="login" style="flex-grow: 0; display: flex; visibility: visible; overflow: visible; height: 100%; width: 100%; flex-shrink: 0;">
                <ui:Label text="INICIAR SESIÓN" name="titulo-login" class="botones-menu" style="color: rgb(108, 230, 22); align-items: center; width: 30%; background-color: rgba(13, 12, 12, 0.98); margin-bottom: 20px; font-size: 50px;"/>
                <ui:TextField label="USUARIO" placeholder-text="filler text" name="login-usuario" style="color: rgb(17, 234, 21); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Regular.ttf?fileID=12800000&amp;guid=0f11804e4dba3704d975b2c9b97ef037&amp;type=3#Orbitron-Regular&quot;); align-items: center; flex-direction: row; justify-content: flex-start; -unity-text-align: upper-center;"/>
                <ui:TextField label="CONTRASEÑA" placeholder-text="filler text" name="login-password" password="true" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Regular.ttf?fileID=12800000&amp;guid=0f11804e4dba3704d975b2c9b97ef037&amp;type=3#Orbitron-Regular&quot;); color: rgb(89, 236, 39); -unity-text-align: upper-center;"/>
                <ui:Button text="ENTRAR" name="login-boton" class="botones-menu" style="width: 30%; background-color: rgb(0, 0, 0); color: rgb(0, 255, 0);"/>
                <ui:Label text="VACIO" name="mensaje-login" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Regular.ttf?fileID=12800000&amp;guid=0f11804e4dba3704d975b2c9b97ef037&amp;type=3#Orbitron-Regular&quot;); color: rgb(0, 255, 0);"/>
            </ui:VisualElement>
            <ui:VisualElement name="contenido-terapeuta" style="flex-grow: 1; display: none; width: 100%; height: 100%; visibility: hidden;">
                <ui:VisualElement name="barra-superior">
                    <ui:Label text="PANEL DEL TERAPEUTA" name="Label" class="letrasColor"/>
                    <ui:VisualElement name="acciones-globales">
                        <ui:Button text="REGISTRAR PACIENTE" name="btn-abrir-registro"/>
                        <ui:Button text="CERRAR SESION" name="btn-cerrar-sesion-terapeuta"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="cuerpo">
                    <ui:VisualElement name="columna-pacientes">
                        <ui:Label text="MIS PACIENTES" class="letrasColor" style="-unity-font-style: bold;"/>
                        <ui:VisualElement name="contenedor-busqueda" style="flex-grow: 1;">
                            <ui:Label text="Buscar pacientes por cédula" class="letrasColor" style="-unity-font-style: normal; white-space: normal; width: 100%;"/>
                            <ui:TextField label="INGRESE CÉDULA" placeholder-text="" name="input-busqueda" style="background-color: rgb(30, 31, 42); color: rgb(245, 245, 245); width: 100%; height: 35px; margin-top: 5px; margin-bottom: 5px;"/>
                            <ui:Button text="BUSCAR" name="btn-buscar" class="letrasColor" style="width: 100%; height: 35px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="resultado-paciente" class="letrasColor" style="flex-grow: 1; display: none; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; margin-top: 15px; white-space: normal; justify-content: flex-start;">
                            <ui:Label text="Label" name="lbl-resultado-nombre" style="margin-bottom: 5px;"/>
                            <ui:Label text="Label" name="lbl-resultado-edad" style="margin-bottom: 5px;"/>
                            <ui:Label text="Label" name="lbl-resultado-sesion" style="margin-bottom: 5px; white-space: normal;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="columna-detalle">
                        <ui:VisualElement name="detalle-vacio">
                            <ui:Label text="Selecciona un paciente de la lista"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="detalle-paciente" style="align-items: flex-start; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;">
                            <ui:Label text="Paciente" name="lbl-paciente-nombre"/>
                            <ui:VisualElement name="acciones-paciente">
                                <ui:Button text="VER REPORTES" name="btn-ver-reportes"/>
                                <ui:Button text="CONFIGURAR TERAPIAS" name="btn-configurar"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="barra-dev">
                    <ui:Button text="Guardar Sesión de Prueba" name="btn-guardar-prueba"/>
                </ui:VisualElement>
                <ui:VisualElement name="form-registro" style="flex-grow: 1; display: none; position: absolute; top: 20%; right: 20%; left: 20%; bottom: 20%; background-color: rgb(0, 0, 0); overflow: visible; visibility: visible; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; opacity: 1; margin-right: 0; height: auto; align-items: center; justify-content: center; width: auto;">
                    <ui:Button text="X" name="btn-cerrar-x" style="position: absolute; top: 32px; left: 759px; right: 57px; width: 50px; height: 50px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Regular.ttf?fileID=12800000&amp;guid=0f11804e4dba3704d975b2c9b97ef037&amp;type=3#Orbitron-Regular&quot;); -unity-font-style: bold; font-size: 30px;"/>
                    <ui:Label text="REGISTRAR PACIENTE" class="letrasColor" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Regular.ttf?fileID=12800000&amp;guid=0f11804e4dba3704d975b2c9b97ef037&amp;type=3#Orbitron-Regular&quot;); color: rgb(36, 188, 29);"/>
                    <ui:TextField label="CEDULA" placeholder-text="filler text" name="reg-cedula" class="letrasColor" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Regular.ttf?fileID=12800000&amp;guid=0f11804e4dba3704d975b2c9b97ef037&amp;type=3#Orbitron-Regular&quot;); color: rgb(51, 172, 14);"/>
                    <ui:TextField label="NOMBRE" placeholder-text="filler text" name="reg-nombre" class="letrasColor"/>
                    <ui:TextField label="EMAIL" placeholder-text="filler text" name="reg-email" class="letrasColor"/>
                    <ui:IntegerField label="EDAD" value="10" name="reg-edad" class="letrasColor"/>
                    <ui:TextField label="CONTRASEÑA" placeholder-text="filler text" name="reg-contrasena" password="true" class="letrasColor"/>
                    <ui:Button text="GUARDAR" name="btn-guardar-registro" class="letrasColor" style="color: rgb(26, 26, 26);"/>
                    <ui:Label text="Label" name="reg-mensaje"/>
                </ui:VisualElement>
                <ui:VisualElement name="panel-reportes" style="flex-grow: 1; display: none; position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.59); align-items: center; justify-content: center; top: 0; left: 2px;">
                    <ui:VisualElement name="tarjeta-reportes" style="flex-grow: 1; width: 90%; height: 90%; background-color: rgb(30, 30, 30); padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; align-items: stretch; display: flex;">
                        <ui:Label text="Evolución del Paciente" class="terapias-titulo"/>
                        <ui:Button text="X" name="btn-cerrar-reportes" style="position: absolute; top: 12px; right: 12px;"/>
                        <ui:ScrollView name="reportes-contenido" horizontal-scroller-visibility="Hidden" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="panel-config-terapias">
                    <ui:VisualElement name="tarjeta-config">
                        <ui:VisualElement name="cabecera-config">
                            <ui:Label text="Configurar terapias" name="lbl-config-titulo"/>
                            <ui:Button text="X" name="btn-cerrar-config"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="cuerpo-config">
                            <ui:VisualElement name="columna-lista-terapias">
                                <ui:Label text="TERAPIAS DISPONIBLES" class="cfg-etq"/>
                                <ui:ScrollView name="lista-terapias"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="columna-detalle-terapia">
                                <ui:ScrollView name="detalle-scroll">
                                    <ui:Label text="Terapia" name="lbl-terapia-nombre"/>
                                    <ui:Label text="Objetivo" name="lbl-terapia-objetivo"/>
                                    <ui:Label text="NIVEL" class="cfg-etq"/>
                                    <ui:VisualElement name="niveles-config">
                                        <ui:Button text="Baja" name="btn-nivel-baja"/>
                                        <ui:Button text="Media" name="btn-nivel-media"/>
                                        <ui:Button text="Alta" name="btn-nivel-alta"/>
                                    </ui:VisualElement>
                                    <ui:Label text="VARIABLES" class="cfg-etq"/>
                                    <ui:VisualElement name="contenedor-variables"/>
                                </ui:ScrollView>
                                <ui:VisualElement name="pie-config">
                                    <ui:Label text="" name="lbl-config-estado"/>
                                    <ui:Button text="VER TERAPIA" name="btn-ver-terapia"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
